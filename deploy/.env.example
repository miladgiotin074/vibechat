# ============================================================================
# Vibe Chat — production environment.  cp .env.example .env  and fill it in.
# Generate secrets with:  openssl rand -hex 32
# ============================================================================

APP_NAME=Vibe Chat
# deploy/install.sh fills this file in for you (domain, bot, secrets). By hand: cp .env.example .env
# Hostnames (all proxied through Cloudflare, SSL "Full (strict)"). Keep them ONE level under the
# domain (vibe-api.example.com, not api.vibe.example.com): Cloudflare's free certificate and the
# origin certificate only cover *.example.com.
APP_DOMAIN=vibe.example.com
API_DOMAIN=vibe-api.example.com
ADMIN_DOMAIN=vibe-admin.example.com
# photos (served from this server); not needed with Cloudflare R2
MEDIA_DOMAIN=vibe-media.example.com

# ---- API ----------------------------------------------------------------------
PUBLIC_BASE_URL=https://vibe-api.example.com
CORS_ORIGINS=https://vibe.example.com,https://vibe-admin.example.com
TRUST_PROXY=true
LOG_LEVEL=info
JWT_SECRET=change-me-openssl-rand-hex-32
ADMIN_JWT_SECRET=change-me-another-openssl-rand-hex-32
# First admin (created once, when no admin exists). Change the password after the first login.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me

# ---- data (single server: leave DATABASE_URL/REDIS_URL empty to use the bundled containers) ----
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# App nodes talking to a separate data node over the private network:
# DATABASE_URL=postgres://vibe:<POSTGRES_PASSWORD>@10.0.0.10:5432/vibe
# REDIS_URL=redis://:<REDIS_PASSWORD>@10.0.0.10:6379
# On the data node: the private IP Postgres/Redis listen on (default 127.0.0.1 = same machine only)
# DATA_BIND_IP=10.0.0.10
DATABASE_POOL_MAX=20
# true when DATABASE_URL points at PgBouncer (transaction pooling)
DATABASE_PGBOUNCER=false

# ---- photos ---------------------------------------------------------------------
# On this server's disk (a Docker volume), served by nginx on MEDIA_DOMAIN.
STORAGE_DRIVER=local
MEDIA_PUBLIC_URL=https://vibe-media.example.com
# Cloudflare R2 instead (needed with several app servers): a bucket "vibe" with a custom domain and
# an API token with Object Read & Write, then
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=vibe
# S3_ACCESS_KEY=<token access key id>
# S3_SECRET_KEY=<token secret>
# S3_FORCE_PATH_STYLE=true
# MEDIA_PUBLIC_URL=https://<the bucket's custom domain>

# ---- Telegram --------------------------------------------------------------------
BOT_TOKEN=
BOT_USERNAME=VibeChatBot
MINIAPP_URL=https://vibe.example.com
BOT_MODE=webhook
BOT_WEBHOOK_SECRET=change-me-openssl-rand-hex-32
TELEGRAM_AUTH_MAX_AGE_S=86400

# ---- Tetra98 online payments (https://tetra98.com) --------------------------------
TETRA_API_KEY=
# true while testing with the sandbox (enable sandbox in the Tetra98 panel first)
TETRA_SANDBOX=true
# also receive the gateway's webhook (needs a webhook key created in the Tetra98 panel)
TETRA_WEBHOOK=false
# Only if the gateway refuses your server's IP range: an Iranian egress proxy, http://user:pass@host:port
TETRA_PROXY_URL=
