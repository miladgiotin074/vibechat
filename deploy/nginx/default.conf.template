# Three hostnames on each app node, all proxied (orange cloud) through Cloudflare with
# SSL mode "Full (strict)" and a Cloudflare Origin Certificate in deploy/certs/.
# Docker's DNS is asked per request (resolver + variables), so scaled "api" replicas all get traffic.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Second line of defence behind Cloudflare's own rate limiting; the API also limits per user.
limit_req_zone $binary_remote_addr zone=perip:20m rate=40r/s;

server {
  listen 80 default_server;
  server_name _;
  # Cloudflare health checks and plain-HTTP requests
  location = /nginx-health { return 200 "ok"; }
  location / { return 301 https://$host$request_uri; }
}

ssl_certificate     /etc/nginx/certs/origin.pem;
ssl_certificate_key /etc/nginx/certs/origin.key;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:20m;
ssl_session_timeout 1d;

# ---------------------------------------------------------------- Mini App (static)
server {
  listen 443 ssl;
  http2 on;
  server_name ${APP_DOMAIN};
  root /usr/share/nginx/miniapp;

  # Telegram embeds the app in its WebView (and in an iframe on Telegram Web): no X-Frame-Options.
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # Hashed build assets never change: cache forever (also at Cloudflare's edge).
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }
  location ~* ^/(fonts|img)/ {
    add_header Cache-Control "public, max-age=2592000";
    try_files $uri =404;
  }
  # The HTML must always be fresh so new releases load immediately.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}

# ---------------------------------------------------------------- API + WebSocket + bot webhook
server {
  listen 443 ssl;
  http2 on;
  server_name ${API_DOMAIN};
  client_max_body_size 14m;

  location /v1/ws {
    set $api http://api:4000;
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    # Cloudflare closes idle WebSockets after 100 s; the app pings every 25 s.
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  location /bot/webhook {
    set $api http://api:4000;
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }

  location / {
    limit_req zone=perip burst=80 nodelay;
    limit_req_status 429;
    set $api http://api:4000;
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;
  }
}

# ---------------------------------------------------------------- photos (media volume)
# Only the public prefixes (photos/, chat/), read-only. With Cloudflare R2 this host is unused.
server {
  listen 443 ssl;
  http2 on;
  server_name ${MEDIA_DOMAIN};
  root /srv/media;

  location ~ ^/(photos|chat)/ {
    limit_except GET HEAD { deny all; }
    # file names never change: Cloudflare and phones keep them
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Access-Control-Allow-Origin "*" always;
    try_files $uri =404;
  }
  location / { return 404; }
}

# ---------------------------------------------------------------- admin panel
server {
  listen 443 ssl;
  http2 on;
  server_name ${ADMIN_DOMAIN};

  # Recommended: put Cloudflare Access (Zero Trust) in front of this hostname as well.
  location / {
    set $admin http://admin:3000;
    proxy_pass $admin;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }
}
