{
  "name": "vibechat-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vibe Chat API, realtime chat, Telegram bot and background worker",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "migrate:prod": "node dist/src/scripts/migrate.js",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --experimental-test-module-mocks --test test/integration/*.test.ts",
    "dev:local": "node --import tsx --experimental-test-module-mocks --env-file-if-exists=.env.local scripts/local.ts",
    "bot:setup": "tsx --env-file-if-exists=.env src/scripts/bot-setup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/websocket": "11.3.4",
    "bullmq": "5.81.5",
    "fastify": "5.12.7",
    "grammy": "1.46.0",
    "ioredis": "5.11.1",
    "jose": "6.2.13",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "sharp": "0.35.5",
    "teleproto": "^1.232.1",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.1",
    "embedded-postgres": "17.10.0-beta.17",
    "ioredis-mock": "8.13.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "msgpackr-extract@3.0.7": true
  }
}
